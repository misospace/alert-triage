{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>misospace/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "groupName": "Go toolchain"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["docker.io/library/golang"],
      "groupName": "Go toolchain"
    }
  ]
}
